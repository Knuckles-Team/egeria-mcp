{
  "mcpServers": {
    "egeria-mcp": {
      "command": "uv",
      "args": [
        "run",
        "egeria-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "ARCHER_APPLICATIONS": "risks,controls,findings",
        "ARIS_API_PATH": "/abs/api/models",
        "CADDY_ADMIN_URL": "http://localhost:2019",
        "EGERIATOOL": "True",
        "EGERIA_ENABLE_WRITE": "False",
        "EGERIA_HARVEST_ENV": "${XDG_CONFIG_HOME}/agent-utilities/egeria-harvest.env",
        "EGERIA_PLATFORM_URL": "https://egeria.example.invalid:9443",
        "EGERIA_VIEW_SERVER": "qs-view-server",
        "KEYCLOAK_REALM": "master",
        "MONGODB_PORT": "27017",
        "MSGRAPH_URL": "https://graph.microsoft.com/v1.0",
        "PORTAINER_ENDPOINT_ID": "3",
        "TWENTY_API_PREFIX": "/rest"
      }
    }
  }
}
